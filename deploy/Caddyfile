# Caddy: the public front door. It gets free HTTPS certificates (Let's Encrypt) by itself and passes
# requests to the app on 127.0.0.1:8080.
# Install: replace manacinema.example below with your domain, then
#          sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

manacinema.example {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	log {
		output file /var/log/caddy/mana-cinema.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# www goes to the main address
www.manacinema.example {
	redir https://manacinema.example{uri} permanent
}
