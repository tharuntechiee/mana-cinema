# MANA CINEMA server settings. Copy this file to .env and fill it in. Never commit .env.

# Port for http://localhost:PORT
PORT=8080

# Password for admin.html. Use a long random one.
ADMIN_PASSWORD=

# Optional: full cast and crew with photos, from TMDB.
# Free key: https://www.themoviedb.org/settings/api (the "API Read Access Token" or the "API Key" both work)
TMDB_API_KEY=

# Optional: trailers with views and likes, from YouTube.
# Free key: Google Cloud console > APIs & Services > enable "YouTube Data API v3" > Credentials > API key
YOUTUBE_API_KEY=
# How many films to search per run (each search uses 100 of YouTube's 10,000 free daily units)
YOUTUBE_SEARCH_LIMIT=40

# Refresh IMDb ratings once a day while the server runs (true or false)
AUTO_SYNC_RATINGS=true

# Where the SQLite database lives (default: data/mana-cinema.db)
# DATABASE_FILE=data/mana-cinema.db

# Behind a host's proxy (Render, Railway, Fly.io, nginx), set to 1 so HTTPS and visitor IPs are seen correctly
# TRUST_PROXY=1

# Public DNS used only for TMDB requests, because some ISPs (Jio, Airtel) block themoviedb.org.
# Leave empty to use the computer's normal DNS.
TMDB_DNS=1.1.1.1,8.8.8.8
