# MANA CINEMA server settings. Copy this file to .env and fill it in. Never commit .env.

# Port for http://localhost:PORT
PORT=8080

# Password for admin.html. Use a long random one.
ADMIN_PASSWORD=

# Optional: full cast and crew with photos, from TMDB.
# Free key: https://www.themoviedb.org/settings/api (the "API Read Access Token" or the "API Key" both work)
TMDB_API_KEY=

# Optional: trailers with views and likes, from YouTube.
# Free key: Google Cloud console > APIs & Services > enable "YouTube Data API v3" > Credentials > API key
YOUTUBE_API_KEY=
# How many films to search per run (each search uses 100 of YouTube's 10,000 free daily units)
YOUTUBE_SEARCH_LIMIT=40

# Refresh IMDb ratings once a day while the server runs (true or false)
AUTO_SYNC_RATINGS=true

# Where the SQLite database lives (default: data/mana-cinema.db)
# DATABASE_FILE=data/mana-cinema.db

# Behind a host's proxy (Caddy, nginx, Render...), set to 1 so HTTPS and visitor IPs are seen correctly
# TRUST_PROXY=1
# Listen only on this address; on a server behind Caddy use 127.0.0.1 (deploy/mana-cinema.service sets it)
# HOST=

# Database backups (npm run backup; nightly on the server): where, and how many to keep
# BACKUP_DIR=data/backups
# BACKUP_KEEP=14

# Public DNS used only for TMDB requests, because some ISPs (Jio, Airtel) block themoviedb.org.
# Leave empty to use the computer's normal DNS.
TMDB_DNS=1.1.1.1,8.8.8.8

# ---------- Viewers' sign-in (one rating per person) ----------
# With either method set up, rating, commenting and liking need an account; reading never does.
# With neither, the site works as before with an anonymous cookie. See docs/research/sign-in-options.md.

# Google sign-in (free). Google Cloud console > Google Auth Platform: fill in Branding (with a link to
# /privacy.html), set Audience to External and "In production", then Clients > Create > Web application.
# Authorised JavaScript origins: your live https:// address, http://localhost and http://localhost:8080.
# Paste the Client ID here (it isn't secret; no client secret is needed).
GOOGLE_CLIENT_ID=

# Email sign-in: a 6-digit code sent to the viewer's email, from your own email account.
#   console   testing on this computer only: no email is sent, the code is printed in the server window
#   smtp      live. For Gmail: turn on 2-Step Verification for the account, then make an app password at
#             https://myaccount.google.com/apppasswords and paste it as SMTP_PASS. A free Gmail account can send
#             about 500 emails a day; Google Workspace about 2,000. Best to use a separate Gmail for the site.
EMAIL_SENDER=
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=   the From address, if not SMTP_USER

# Most sign-in codes the site emails in a day (keep it under your mail account's daily limit)
# CODES_DAILY_LIMIT=400

# Secret for scrambling sign-in codes. Leave empty and one is made and kept in the database.
# AUTH_SECRET=
