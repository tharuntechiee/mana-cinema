{
  "name": "mana-cinema",
  "version": "2.0.0",
  "private": true,
  "description": "MANA CINEMA: Indian box office and ratings hub. Express API and SQLite database.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "sync": "node server/sync/cli.js",
    "sync:ratings": "node server/sync/cli.js ratings",
